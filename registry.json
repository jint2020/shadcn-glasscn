{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "glasscn",
  "homepage": "https://jint2020.github.io/shadcn-glasscn",
  "items": [
    {
      "name": "glass-theme",
      "type": "registry:theme",
      "title": "Glass Theme",
      "description": "Liquid Glass 主题：白色中性玻璃 + 光斑背景，接管 shadcn 的表面 token、阴影量表与圆角。现有组件不改源码即变玻璃。暗色优先，零依赖。",
      "cssVars": {
        "theme": {
          "shadow-2xs": "var(--glass-specular-size) var(--glass-specular-color) inset",
          "shadow-xs": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), 0 2px 8px rgb(0 0 0 / 0.2)",
          "shadow-sm": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), var(--glass-shadow-flat)",
          "shadow-md": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), var(--glass-shadow-raised)",
          "shadow-lg": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), var(--glass-shadow-overlay)",
          "shadow-xl": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), var(--glass-shadow-modal)",
          "shadow-2xl": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), var(--glass-shadow-modal)",
          "blur-glass": "var(--glass-blur-base)",
          "blur-glass-overlay": "var(--glass-blur-overlay)",
          "blur-glass-modal": "var(--glass-blur-modal)",
          "ease-glass": "var(--glass-ease)",
          "ease-glass-out": "var(--glass-ease-out)",
          "ease-glass-spring": "var(--glass-ease-spring)",
          "radius-pill": "var(--glass-radius-pill)",
          "color-glass-accent": "var(--glass-accent)"
        },
        "light": {
          "glass-blur-base": "20px",
          "glass-saturate": "180%",
          "glass-brightness": "1",
          "glass-white": "255 255 255",
          "glass-fill": "0.08",
          "glass-fill-hover": "0.13",
          "glass-border-alpha": "0.12",
          "glass-border-alpha-hover": "0.22",
          "glass-border-width": "1px",
          "glass-specular": "0.2",
          "glass-specular-size": "0 1px 0 0",
          "glass-underline": "0 0 0 0 transparent",
          "glass-shadow-base": "0 12px 40px rgb(0 0 0 / 0.35)",
          "glass-shadow-hover": "0 20px 60px rgb(0 0 0 / 0.5)",
          "glass-duration-fast": "80ms",
          "glass-duration": "240ms",
          "glass-duration-slow": "600ms",
          "glass-duration-color": "150ms",
          "glass-duration-enter": "240ms",
          "glass-duration-exit": "160ms",
          "glass-ease": "cubic-bezier(0.22, 1, 0.36, 1)",
          "glass-ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
          "glass-ease-spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
          "glass-ease-in-out": "cubic-bezier(0.65, 0, 0.35, 1)",
          "glass-lift": "4px",
          "glass-press": "1px",
          "glass-press-scale": "0.97",
          "glass-shimmer-alpha": "0.14",
          "glass-shimmer-angle": "-20deg",
          "glass-shimmer-duration": "900ms",
          "glass-radius-sm": "10px",
          "glass-radius-md": "16px",
          "glass-radius-card": "20px",
          "glass-radius-panel": "28px",
          "glass-radius-pill": "999px",
          "glass-bg": "rgb(var(--glass-white) / var(--glass-fill))",
          "glass-bg-hover": "rgb(var(--glass-white) / var(--glass-fill-hover))",
          "glass-border": "rgb(var(--glass-white) / var(--glass-border-alpha))",
          "glass-border-hover": "rgb(var(--glass-white) / var(--glass-border-alpha-hover))",
          "glass-specular-color": "rgb(var(--glass-white) / var(--glass-specular))",
          "glass-bg-base": "#100d0a",
          "glass-bg-mid": "#1c1510",
          "glass-blob-1": "#f59e0b",
          "glass-blob-2": "#c2410c",
          "glass-blob-3": "#78350f",
          "glass-accent": "#f59e0b",
          "glass-accent-hover": "#fbbf24",
          "glass-accent-fg": "#1a1206",
          "glass-text-rgb": "255 248 240",
          "glass-text-primary": "rgb(var(--glass-text-rgb) / 0.95)",
          "glass-text-secondary": "rgb(var(--glass-text-rgb) / 0.68)",
          "glass-text-muted": "rgb(var(--glass-text-rgb) / 0.38)",
          "glass-danger": "#f87171",
          "glass-danger-fg": "#1a0a0a",
          "glass-blur-flat": "calc(var(--glass-blur-base) * 0.8)",
          "glass-fill-flat": "0.06",
          "glass-shadow-flat": "0 2px 8px rgb(0 0 0 / 0.2)",
          "glass-blur-raised": "var(--glass-blur-base)",
          "glass-fill-raised": "var(--glass-fill)",
          "glass-shadow-raised": "var(--glass-shadow-base)",
          "glass-blur-overlay": "calc(var(--glass-blur-base) * 1.2)",
          "glass-fill-overlay": "0.1",
          "glass-shadow-overlay": "0 16px 48px rgb(0 0 0 / 0.42)",
          "glass-blur-modal": "calc(var(--glass-blur-base) * 1.4)",
          "glass-fill-modal": "0.12",
          "glass-saturate-modal": "200%",
          "glass-shadow-modal": "0 24px 72px rgb(0 0 0 / 0.55)",
          "glass-fill-nav": "0.06",
          "glass-blur-nav": "calc(var(--glass-blur-base) * 1.2)",
          "glass-scrim": "rgb(0 0 0 / 0.55)",
          "glass-scrim-blur": "calc(var(--glass-blur-base) * 0.4)",
          "glass-blur": "var(--glass-blur-raised)",
          "glass-fill-current": "var(--glass-fill-raised)",
          "glass-shadow": "var(--glass-shadow-raised)",
          "glass-font-heading": "\"Outfit\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
          "glass-font-body": "\"DM Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
          "glass-tracking-heading": "-0.02em",
          "glass-tracking-caps": "0.14em",
          "glass-text-h1": "clamp(2.5rem, 5vw, 4.5rem)",
          "glass-text-h2": "clamp(1.8rem, 3vw, 3rem)",
          "glass-text-h3": "1.5rem",
          "glass-leading-heading": "1.1",
          "glass-leading-body": "1.75",
          "background": "var(--glass-bg-base)",
          "foreground": "var(--glass-text-primary)",
          "card": "rgb(var(--glass-white) / var(--glass-fill-raised))",
          "card-foreground": "var(--glass-text-primary)",
          "popover": "rgb(var(--glass-white) / var(--glass-fill-overlay))",
          "popover-foreground": "var(--glass-text-primary)",
          "secondary": "rgb(var(--glass-white) / var(--glass-fill-raised))",
          "secondary-foreground": "var(--glass-text-primary)",
          "muted": "rgb(var(--glass-white) / var(--glass-fill-flat))",
          "accent": "rgb(var(--glass-white) / var(--glass-fill-hover))",
          "accent-foreground": "var(--glass-text-primary)",
          "input": "rgb(var(--glass-white) / var(--glass-fill-flat))",
          "sidebar": "rgb(var(--glass-white) / var(--glass-fill-overlay))",
          "sidebar-foreground": "var(--glass-text-primary)",
          "sidebar-accent": "rgb(var(--glass-white) / var(--glass-fill-hover))",
          "sidebar-accent-foreground": "var(--glass-text-primary)",
          "border": "var(--glass-border)",
          "sidebar-border": "var(--glass-border)",
          "ring": "var(--glass-accent)",
          "primary": "var(--glass-accent)",
          "primary-foreground": "var(--glass-accent-fg)",
          "sidebar-primary": "var(--glass-accent)",
          "sidebar-primary-foreground": "var(--glass-accent-fg)",
          "destructive": "var(--glass-danger)",
          "destructive-foreground": "var(--glass-danger-fg)",
          "muted-foreground": "var(--glass-text-secondary)",
          "sidebar-ring": "var(--glass-accent)",
          "radius": "16px"
        }
      },
      "css": {
        "@utility glass-surface": {
          "background-color": "rgb(var(--glass-white) / var(--glass-fill-current))",
          "-webkit-backdrop-filter": "blur(var(--glass-blur)) saturate(var(--glass-saturate))",
          "backdrop-filter": "blur(var(--glass-blur)) saturate(var(--glass-saturate))",
          "border": "var(--glass-border-width) solid var(--glass-border)",
          "box-shadow": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-underline), var(--glass-shadow)",
          "border-radius": "var(--glass-radius-card)"
        },
        "@utility glass-flat": {
          "--glass-blur": "var(--glass-blur-flat)",
          "--glass-fill-current": "var(--glass-fill-flat)",
          "--glass-shadow": "var(--glass-shadow-flat)"
        },
        "@utility glass-raised": {
          "--glass-blur": "var(--glass-blur-raised)",
          "--glass-fill-current": "var(--glass-fill-raised)",
          "--glass-shadow": "var(--glass-shadow-raised)"
        },
        "@utility glass-overlay": {
          "--glass-blur": "var(--glass-blur-overlay)",
          "--glass-fill-current": "var(--glass-fill-overlay)",
          "--glass-shadow": "var(--glass-shadow-overlay)"
        },
        "@utility glass-modal": {
          "--glass-blur": "var(--glass-blur-modal)",
          "--glass-fill-current": "var(--glass-fill-modal)",
          "--glass-shadow": "var(--glass-shadow-modal)",
          "--glass-saturate": "var(--glass-saturate-modal)"
        },
        "@utility glass-panel": {
          "border-radius": "var(--glass-radius-panel)"
        },
        "@utility glass-pill": {
          "border-radius": "var(--glass-radius-pill)"
        },
        "@utility glass-scrim": {
          "background-color": "var(--glass-scrim)",
          "-webkit-backdrop-filter": "blur(var(--glass-scrim-blur)) saturate(140%)",
          "backdrop-filter": "blur(var(--glass-scrim-blur)) saturate(140%)"
        },
        "@utility glass-nav": {
          "background-color": "rgb(var(--glass-white) / var(--glass-fill-nav))",
          "-webkit-backdrop-filter": "blur(var(--glass-blur-nav)) saturate(var(--glass-saturate))",
          "backdrop-filter": "blur(var(--glass-blur-nav)) saturate(var(--glass-saturate))",
          "border": "0",
          "border-bottom": "var(--glass-border-width) solid rgb(var(--glass-white) / 0.08)",
          "border-radius": "0",
          "box-shadow": "0 1px 0 0 rgb(var(--glass-white) / 0.06) inset"
        },
        "@utility glass-menu": {
          "background-color": "rgb(var(--glass-white) / 0.1)",
          "-webkit-backdrop-filter": "blur(28px) saturate(200%)",
          "backdrop-filter": "blur(28px) saturate(200%)",
          "border": "var(--glass-border-width) solid rgb(var(--glass-white) / 0.14)",
          "border-radius": "var(--glass-radius-card)",
          "box-shadow": "0 1px 0 0 rgb(var(--glass-white) / 0.18) inset, 0 20px 60px rgb(0 0 0 / 0.4)",
          "overflow": "hidden"
        },
        "@utility glass-premium": {
          "position": "relative",
          "border-color": "transparent",
          "&::before": {
            "content": "\"\"",
            "position": "absolute",
            "inset": "0",
            "z-index": "1",
            "border-radius": "inherit",
            "padding": "var(--glass-border-width)",
            "pointer-events": "none",
            "background": "linear-gradient( 135deg, rgb(var(--glass-white) / 0.45) 0%, rgb(var(--glass-white) / 0.12) 32%, rgb(var(--glass-white) / 0) 65% )",
            "mask": "linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)",
            "mask-composite": "exclude",
            "-webkit-mask": "linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0)",
            "-webkit-mask-composite": "xor"
          }
        },
        "@utility glass-blur-*": {
          "--glass-blur": "--value([length], --blur- *)"
        },
        "@utility glass-fill-*": {
          "--glass-fill-current": "calc(--value(integer) / 100)"
        },
        "@utility glass-nested": {
          "-webkit-backdrop-filter": "none",
          "backdrop-filter": "none",
          "--glass-fill-current": "0.05",
          "--glass-shadow": "none"
        },
        "@utility glass-interactive": {
          "transition-property": "transform, box-shadow, background-color, border-color",
          "transition-duration": "var(--glass-duration), var(--glass-duration), var(--glass-duration-color), var(--glass-duration-color)",
          "transition-timing-function": "var(--glass-ease), var(--glass-ease), var(--glass-ease-out), var(--glass-ease-out)",
          "will-change": "transform",
          "&:hover:not(:disabled, [data-disabled], [aria-disabled=\"true\"])": {
            "transform": "translateY(calc(var(--glass-lift) * -1))",
            "background-color": "rgb(var(--glass-white) / var(--glass-fill-hover))",
            "border-color": "var(--glass-border-hover)",
            "box-shadow": "var(--glass-specular-size) var(--glass-specular-color) inset, var(--glass-shadow-hover)"
          },
          "&:active:not(:disabled, [data-disabled], [aria-disabled=\"true\"])": {
            "transform": "translateY(var(--glass-press)) scale(var(--glass-press-scale))",
            "transition-duration": "var(--glass-duration-fast)"
          },
          "&:disabled, &[data-disabled], &[aria-disabled=\"true\"]": {
            "opacity": "0.45",
            "cursor": "not-allowed",
            "box-shadow": "var(--glass-specular-size) var(--glass-specular-color) inset"
          }
        },
        "@keyframes glass-shimmer-sweep": {
          "from": {
            "transform": "translateX(-130%) skewX(var(--glass-shimmer-angle))"
          },
          "to": {
            "transform": "translateX(230%) skewX(var(--glass-shimmer-angle))"
          }
        },
        "@utility glass-shimmer": {
          "position": "relative",
          "overflow": "hidden",
          "&::after": {
            "content": "\"\"",
            "position": "absolute",
            "top": "0",
            "bottom": "0",
            "left": "0",
            "width": "45%",
            "z-index": "2",
            "pointer-events": "none",
            "opacity": "0",
            "background": "linear-gradient( 90deg, transparent 0%, rgb(var(--glass-white) / var(--glass-shimmer-alpha)) 50%, transparent 100% )",
            "transform": "translateX(-130%) skewX(var(--glass-shimmer-angle))"
          },
          "&:hover::after": {
            "opacity": "1",
            "animation": "glass-shimmer-sweep var(--glass-shimmer-duration) var(--glass-ease-out)"
          }
        },
        "@utility glass-ring": {
          "&:focus-visible": {
            "outline": "none",
            "border-color": "rgb(var(--glass-white) / 0.3)",
            "box-shadow": "var(--glass-specular-size) var(--glass-specular-color) inset, 0 0 0 1px rgb(var(--glass-white) / 0.3), 0 0 0 4px color-mix(in oklab, var(--glass-accent) 35%, transparent), var(--glass-shadow)"
          }
        },
        "@utility glass-highlight": {
          "transition": "background-color var(--glass-duration-fast) var(--glass-ease-out), color var(--glass-duration-fast) var(--glass-ease-out)",
          "&[data-highlighted], &[data-state=\"checked\"], &:hover:not([data-disabled])": {
            "background-color": "rgb(var(--glass-white) / 0.1)"
          }
        },
        "@utility glass-cta": {
          "background-color": "var(--glass-accent)",
          "color": "var(--glass-accent-fg)",
          "border": "var(--glass-border-width) solid transparent",
          "border-radius": "var(--glass-radius-pill)",
          "box-shadow": "0 1px 0 0 rgb(var(--glass-white) / 0.25) inset, 0 8px 24px -8px color-mix(in oklab, var(--glass-accent) 60%, transparent)",
          "transition-property": "transform, filter, box-shadow",
          "transition-duration": "var(--glass-duration), var(--glass-duration-color), var(--glass-duration)",
          "transition-timing-function": "var(--glass-ease), var(--glass-ease-out), var(--glass-ease)",
          "&:hover:not(:disabled, [aria-disabled=\"true\"])": {
            "transform": "translateY(-2px)",
            "filter": "brightness(1.1)",
            "box-shadow": "0 1px 0 0 rgb(var(--glass-white) / 0.3) inset, 0 14px 32px -10px color-mix(in oklab, var(--glass-accent) 70%, transparent)"
          },
          "&:active:not(:disabled, [aria-disabled=\"true\"])": {
            "transform": "translateY(1px) scale(var(--glass-press-scale))",
            "transition-duration": "var(--glass-duration-fast)"
          }
        },
        "@keyframes glass-blob-float": {
          "0%, 100%": {
            "transform": "translate3d(0, 0, 0) scale(1)"
          },
          "33%": {
            "transform": "translate3d(6%, -8%, 0) scale(1.12)"
          },
          "66%": {
            "transform": "translate3d(-5%, 6%, 0) scale(0.92)"
          }
        },
        "@utility glass-backdrop": {
          "position": "relative",
          "isolation": "isolate",
          "min-height": "100vh",
          "background-color": "var(--glass-bg-base)",
          "background-image": "linear-gradient( 160deg, var(--glass-bg-base) 0%, var(--glass-bg-mid) 55%, var(--glass-bg-base) 100% )",
          "color": "var(--glass-text-primary)",
          "font-family": "var(--glass-font-body)",
          "&::before, &::after": {
            "content": "\"\"",
            "position": "fixed",
            "z-index": "-1",
            "border-radius": "50%",
            "pointer-events": "none",
            "will-change": "transform",
            "animation": "glass-blob-float 10s var(--glass-ease-in-out) infinite"
          },
          "&::before": {
            "width": "650px",
            "height": "650px",
            "top": "-12%",
            "left": "-8%",
            "opacity": "0.55",
            "background": "radial-gradient( circle at 50% 50%, var(--glass-blob-1) 0%, transparent 68% )",
            "filter": "blur(90px)"
          },
          "&::after": {
            "width": "450px",
            "height": "450px",
            "right": "-6%",
            "bottom": "-10%",
            "opacity": "0.5",
            "background": "radial-gradient( circle at 50% 50%, var(--glass-blob-2) 0%, transparent 68% )",
            "filter": "blur(90px)",
            "animation-delay": "-4s"
          }
        },
        "@utility glass-blob-accent": {
          "position": "relative",
          "&::before": {
            "content": "\"\"",
            "position": "fixed",
            "z-index": "-1",
            "top": "38%",
            "left": "46%",
            "width": "350px",
            "height": "350px",
            "border-radius": "50%",
            "pointer-events": "none",
            "opacity": "0.42",
            "background": "radial-gradient( circle at 50% 50%, var(--glass-blob-3) 0%, transparent 68% )",
            "filter": "blur(90px)",
            "will-change": "transform",
            "animation": "glass-blob-float 10s var(--glass-ease-in-out) -7s infinite"
          }
        },
        "@utility glass-reveal": {
          "opacity": "0",
          "transform": "translateY(24px)",
          "filter": "blur(8px)",
          "transition": "opacity var(--glass-duration-slow) var(--glass-ease), transform var(--glass-duration-slow) var(--glass-ease), filter calc(var(--glass-duration-slow) * 0.85) var(--glass-ease-out)",
          "&.is-revealed": {
            "opacity": "1",
            "transform": "none",
            "filter": "none"
          }
        },
        "@utility glass-reveal-stagger": {
          "& > *": {
            "transition-delay": "0ms"
          },
          "& > *:nth-child(2)": {
            "transition-delay": "80ms"
          },
          "& > *:nth-child(3)": {
            "transition-delay": "160ms"
          },
          "& > *:nth-child(4)": {
            "transition-delay": "240ms"
          },
          "& > *:nth-child(5)": {
            "transition-delay": "320ms"
          },
          "& > *:nth-child(n + 6)": {
            "transition-delay": "400ms"
          }
        },
        "@keyframes glass-fade-in": {
          "from": {
            "opacity": "0"
          }
        },
        "@keyframes glass-fade-out": {
          "to": {
            "opacity": "0"
          }
        },
        "@keyframes glass-modal-in": {
          "from": {
            "opacity": "0",
            "transform": "translate(-50%, -52%) scale(0.96)"
          }
        },
        "@keyframes glass-modal-out": {
          "to": {
            "opacity": "0",
            "transform": "translate(-50%, -52%) scale(0.96)"
          }
        },
        "@keyframes glass-pop-in": {
          "from": {
            "opacity": "0",
            "transform": "translateY(4px) scale(0.98)"
          }
        },
        "@keyframes glass-pop-out": {
          "to": {
            "opacity": "0",
            "transform": "translateY(4px) scale(0.98)"
          }
        },
        "@keyframes glass-tip-in": {
          "from": {
            "opacity": "0",
            "transform": "translateY(2px) scale(0.97)"
          }
        },
        "@keyframes glass-tip-out": {
          "to": {
            "opacity": "0",
            "transform": "translateY(2px) scale(0.97)"
          }
        },
        "@keyframes glass-sheet-in-bottom": {
          "from": {
            "opacity": "0",
            "transform": "translateY(16px)"
          }
        },
        "@keyframes glass-sheet-out-bottom": {
          "to": {
            "opacity": "0",
            "transform": "translateY(16px)"
          }
        },
        "@keyframes glass-sheet-in-top": {
          "from": {
            "opacity": "0",
            "transform": "translateY(-16px)"
          }
        },
        "@keyframes glass-sheet-out-top": {
          "to": {
            "opacity": "0",
            "transform": "translateY(-16px)"
          }
        },
        "@keyframes glass-sheet-in-left": {
          "from": {
            "opacity": "0",
            "transform": "translateX(-16px)"
          }
        },
        "@keyframes glass-sheet-out-left": {
          "to": {
            "opacity": "0",
            "transform": "translateX(-16px)"
          }
        },
        "@keyframes glass-sheet-in-right": {
          "from": {
            "opacity": "0",
            "transform": "translateX(16px)"
          }
        },
        "@keyframes glass-sheet-out-right": {
          "to": {
            "opacity": "0",
            "transform": "translateX(16px)"
          }
        },
        "@keyframes glass-accordion-in": {
          "from": {
            "grid-template-rows": "0fr",
            "opacity": "0.4"
          }
        },
        "@keyframes glass-accordion-out": {
          "to": {
            "grid-template-rows": "0fr",
            "opacity": "0.4"
          }
        },
        "@keyframes glass-skeleton-sweep": {
          "from": {
            "background-position": "200% 0"
          },
          "to": {
            "background-position": "-200% 0"
          }
        },
        "@utility glass-skeleton": {
          "position": "relative",
